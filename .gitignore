# Real data never enters the workspace. This is a backstop, not the control —
# the control is that real CSVs live at $HEARTH_DATA_DIR, outside this repo.
.env
data/

# Eval runs recorded against a tree with uncommitted changes. They measured no
# commit, so they cannot be compared to one — useful while iterating, never
# worth keeping. A clean run writes evals/results/<sha>.json, which IS tracked.
evals/results/*-dirty.json

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

node_modules/
dist/

.DS_Store
