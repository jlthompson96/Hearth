# Copy to .env and fill in. .env is gitignored and is never read into a session.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=hearth
POSTGRES_PASSWORD=choose-something-local
POSTGRES_DB=hearth
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://hearth:choose-something-local@localhost:5432/hearth
# Query tools connect as this role and it must not be able to write (Phase 1).
DATABASE_URL_RO=postgresql+psycopg://hearth_ro:choose-something-local@localhost:5432/hearth

# --- Inference (LM Studio, OpenAI-compatible) ---------------------------------
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=not-needed

# Set these to the ids LM Studio reports for the models you loaded. There are
# no defaults in code, so the inference layer will not start without them.
# Nothing larger than ~8B at Q4 fits alongside the embedding model in 8GB.
CHAT_MODEL=
# Pinned. Changing it means re-embedding everything — see the README.
EMBEDDING_MODEL=
# How much the model reasons before answering, for calls that do not set their
# own: none | low | medium | high, or unset to leave it to the model. Leave it
# unset. The router and the title call set "none" themselves because that was
# measured; the specialists stop calling tools with it off (2026-09-21).
# REASONING_EFFORT=

# --- Native Postgres (optional) -----------------------------------------------
# Leave both unset to run Postgres under docker compose, which is the default.
#
# Setting PGDATA switches `make up`, `make down` and `make logs` to a native
# cluster driven by pg_ctl instead — for a machine with no working Docker. Get
# one without an installer or admin rights from the PostgreSQL Windows binary
# zip: extract it, then
#
#   initdb -D <PGDATA> -U hearth --auth-host=scram-sha-256 --pwfile=<file>
#   createdb -h 127.0.0.1 -U hearth hearth
#
# Native gives you Postgres alone. SearXNG is a compose service, so Phase 9 will
# need Docker or a native SearXNG. pgvector is not in the zip and needs an MSVC
# build, so Phase 10 needs it installed before RAG can run; nothing earlier
# touches a vector column.
PGBIN=
PGDATA=

# --- SearXNG ------------------------------------------------------------------
SEARXNG_URL=http://localhost:8080
SEARXNG_PORT=8080
# openssl rand -hex 32
SEARXNG_SECRET=

# --- Real data ----------------------------------------------------------------
# Absolute path, outside this repo. Real CSVs never enter the workspace.
HEARTH_DATA_DIR=

# --- Ports --------------------------------------------------------------------
API_PORT=8000
WEB_PORT=5173

# --- Telemetry ----------------------------------------------------------------
# No third-party telemetry, anywhere. Do not change these.
#
# langsmith arrives as a transitive dependency of langchain-core and is inert
# unless these are set. Newer langchain reads the LANGSMITH_ names, older the
# LANGCHAIN_ ones, so both are pinned off.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=1
